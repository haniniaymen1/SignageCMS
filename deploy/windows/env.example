# ============================================================
#  SignageCMS - Exemple de configuration (.env)
#  install.bat cree automatiquement ce fichier a la racine du
#  projet avec le bon chemin de base de donnees. Copiez-le
#  manuellement seulement si vous n'utilisez pas les scripts.
# ============================================================

# Base SQLite : chemin ABSOLU avec slashes, ex :
#   C:\SignageCMS\db\custom.db  ->  file:C:/SignageCMS/db/custom.db
DATABASE_URL=file:C:/SignageCMS/db/custom.db

# Optionnel : autoriser l'intégration de l'interface du CMS dans une iframe
# externe (portail, panneau d'aperçu). Laissez commenté pour conserver la
# protection anti-clickjacking (recommandé). /player reste toujours intégrable.
# ALLOW_FRAME_EMBED=1

# Limite de téléversement en Mo (surcharge le réglage « maxUploadSize » de
# l'interface Paramètres). Laissez commenté pour utiliser le réglage de l'UI.
# MAX_UPLOAD_MB=500

# Binaires de conversion des présentations (PPT/PPTX/ODP -> PDF -> PNG) :
# détectés automatiquement sur Windows (LibreOffice + Poppler). Forçage
# possible si l'installation est non standard :
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# PDFTOPPM_PATH=C:/poppler/Library/bin/pdftoppm.exe
